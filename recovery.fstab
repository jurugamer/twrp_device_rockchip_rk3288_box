# Partições de Sistema (Android 7.1 RK3288)
/system          ext4     /dev/block/rknand_system         flags=display="System";backup=1
/cache           ext4     /dev/block/rknand_cache          flags=display="Cache"
/metadata        ext4     /dev/block/rknand_metadata       flags=display="Metadata"
/data            ext4     /dev/block/rknand_userdata       flags=display="Data";backup=1

# Partições de Inicialização e Firmware (Kernel e Imagens)
/boot            emmc     /dev/block/rknand_boot           flags=display="Boot";backup=1;flashimg=1
/recovery        emmc     /dev/block/rknand_recovery       flags=display="Recovery";backup=1;flashimg=1
/misc            emmc     /dev/block/rknand_misc           flags=display="Misc"
/backup          emmc     /dev/block/rknand_backup         flags=display="Backup"
/resource        emmc     /dev/block/rknand_resource       flags=display="Resource"
/kernel          emmc     /dev/block/rknand_kernel         flags=display="Kernel"

# Armazenamento Externo (MicroSD e Pendrive USB)
/external_sd     vfat     /dev/block/mmcblk0p1  /dev/block/mmcblk0    flags=display="MicroSD";storage;wipeingui;removable
/usb_otg         vfat     /dev/block/sda1       /dev/block/sda        flags=display="USB-OTG";storage;wipeingui;removable