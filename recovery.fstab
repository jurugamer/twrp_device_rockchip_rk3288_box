# Sistema e Dados (eMMC mmcblk1)
/system          ext4     /dev/block/mmcblk1p12       flags=display="System";backup=1
/cache           ext4     /dev/block/mmcblk1p11       flags=display="Cache"
/metadata        ext4     /dev/block/mmcblk1p13       flags=display="Metadata"
/data            ext4     /dev/block/mmcblk1p16       flags=display="Data";backup=1

# Partições de Boot e Recovery
/boot            emmc     /dev/block/mmcblk1p8        flags=display="Boot";backup=1;flashimg=1
/recovery        emmc     /dev/block/mmcblk1p9        flags=display="Recovery";backup=1;flashimg=1
/misc            emmc     /dev/block/mmcblk1p3        flags=display="Misc"

# Armazenamento Externo (MicroSD e USB)
/external_sd     vfat     /dev/block/mmcblk0p1        flags=display="MicroSD";storage;wipeingui;removable
/usb_otg         vfat     /dev/block/sda1             flags=display="USB-OTG";storage;wipeingui;removable
